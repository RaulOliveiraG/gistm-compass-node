# Copie este arquivo para ".env" e preencha os valores.

# App (role sem BYPASSRLS — sujeito a Row Level Security)
DATABASE_URL="postgresql://gistm_app:gistm@127.0.0.1:5434/gistm_compass?schema=public"
# Migrations e seed (role dono/superuser do Docker)
DATABASE_ADMIN_URL="postgresql://gistm:gistm@127.0.0.1:5434/gistm_compass?schema=public"

# Segredo de sessão (gere qualquer string aleatória longa):
AUTH_SECRET="troque-por-uma-string-aleatoria-longa"
# URL canônica da app atrás do reverse proxy (produção):
# AUTH_URL="https://compass.exemplo.com"

# Cadastro público de organização (dev: true; produção: false)
ALLOW_PUBLIC_SIGNUP="true"

# Armazenamento de documentos: local (pasta uploads/) ou s3 (Azure/AWS/MinIO)
STORAGE_DRIVER="local"
# S3_ENDPOINT="https://<account>.blob.core.windows.net"
# S3_REGION="us-east-1"
# S3_BUCKET="gistm-compass"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="true"

# Chave da API da Anthropic (necessária só para o Assistente de IA e a leitura por IA):
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Análise em lote ("Rodar análise da IA") com a IA real. Padrão: false (palavras-chave).
AI_BATCH_REAL_AI=false

# ---------------------------------------------------------------------------
# Amazon Lightsail Containers (produção) — variáveis do serviço, não bake na imagem
# ---------------------------------------------------------------------------
# AUTH_URL="https://<seu-dominio-ou-default-lightsail>"
# ALLOW_PUBLIC_SIGNUP="false"
# STORAGE_DRIVER="s3"
# PORT="80"
# HOSTNAME="0.0.0.0"
# (também: DATABASE_URL, AUTH_SECRET, S3_*, ANTHROPIC_API_KEY se usar IA)
# Análise em lote ("Rodar análise da IA") com a IA real. Padrão: false (palavras-chave).
AI_BATCH_REAL_AI=false
# Se o bind na 80 falhar no runtime, use PORT=3000 e abra essa porta no serviço.

