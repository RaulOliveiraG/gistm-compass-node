generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Estrutura de requisitos do GISTM: Princípio (tópico) > Tema > Requisito
// ---------------------------------------------------------------------------

model Principle {
  id     String  @id @default(cuid())
  number Int     @unique
  name   String
  // Nome em inglês (conteúdo oficial do GISTM, bilíngue PT/EN).
  nameEn String?
  themes Theme[]
}

model Theme {
  id           String        @id @default(cuid())
  number       Int           @unique
  name         String
  nameEn       String?
  principleId  String
  principle    Principle     @relation(fields: [principleId], references: [id])
  requirements Requirement[]
  justificationTemplates JustificationTemplate[]
}

model Requirement {
  id              String   @id @default(cuid())
  code            String   @unique
  title           String
  description     String
  titleEn         String?
  descriptionEn   String?
  // Biblioteca de evidências esperadas: o que normalmente comprova este
  // requisito, para orientar o que o usuário deveria reunir/anexar.
  expectedEvidence String?
  expectedEvidenceEn String?
  themeId         String
  theme           Theme    @relation(fields: [themeId], references: [id])

  evidences        Evidence[]
  assessments      Assessment[]
  externalAnalyses ExternalAnalysis[]
}

// ---------------------------------------------------------------------------
// Organizações e usuários (autenticação e isolamento entre clientes)
// ---------------------------------------------------------------------------

// Cada empresa cliente é uma Organization — as Installations pertencem a ela,
// nunca são compartilhadas entre organizações diferentes. Isso é o que torna
// a plataforma de fato multi-cliente (antes, era só um banco único com URLs
// diferentes, sem nenhuma barreira real entre clientes).
model Organization {
  id        String         @id @default(cuid())
  name      String
  createdAt DateTime       @default(now())
  users     User[]
  installations Installation[]
}

enum UserRole {
  ADMIN
  MEMBER
}

model User {
  id                  String       @id @default(cuid())
  email               String       @unique
  passwordHash        String
  name                String
  role                UserRole     @default(MEMBER)
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id])
  failedLoginAttempts Int          @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime     @default(now())

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Instalações e ciclos de avaliação
// ---------------------------------------------------------------------------

// Fase do ciclo de vida da estrutura. Estruturas NOVA ou EM_CONSTRUCAO
// recebem "Não se aplica" automático nos requisitos válidos só para
// estruturas existentes (ver src/lib/applicability.ts).
enum InstallationPhase {
  NOVA
  EM_CONSTRUCAO
  OPERACAO
  INATIVA
  FECHAMENTO
}

model Installation {
  id             String       @id @default(cuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())

  // Cadastro da estrutura (itens 10 e 11)
  location             String?
  phase                InstallationPhase @default(OPERACAO)
  hasDpaClassification Boolean?          // já tem classificação de DPA?
  dpaClassification    String?           // ALTO | MEDIO | BAIXO
  eorName              String?           // Engenheiro de Registro (EoR)
  eorCompany           String?
  eorEmail             String?
  rtfeName             String?           // Engenheiro Responsável pela Estrutura (RTFE)
  accountableExecutive String?           // Executivo Responsável
  otherResponsibles    String?           // demais pessoas (texto livre, uma por linha)

  // Enquadramento legal (aba "Normas e prazos")
  country              String   @default("BR") // ISO 3166-1 alfa-2
  uf                   String?           // estado, quando no Brasil
  inPnsb               Boolean?          // inserida na Política Nacional de Segurança de Barragens
  criClassification    String?           // Categoria de Risco: ALTO | MEDIO | BAIXO
  constructionMethod   String?           // MONTANTE | JUSANTE | LINHA_DE_CENTRO | ETAPA_UNICA | OUTRO
  gistmConsequence     String?           // BAIXA | SIGNIFICATIVA | ALTA | MUITO_ALTA | EXTREMA
  zasCommunity         Boolean?          // há comunidade na Zona de Autossalvamento?

  documents        DocumentFile[]
  assessments      Assessment[]
  cycles           Cycle[]
  externalAnalyses ExternalAnalysis[]
  analysisRuns     AnalysisRun[]
  legalChecks      LegalCheck[]

  @@index([organizationId])
}

// Checklist legal (aba "Normas e prazos"): uma linha por obrigação do
// catálogo em src/lib/legal-catalog.ts. A IA sugere (ai*) e uma pessoa valida
// (final*), como na avaliação dos requisitos GISTM.
model LegalCheck {
  id              String       @id @default(cuid())
  installationId  String
  installation    Installation @relation(fields: [installationId], references: [id])
  obligationCode  String       // código da obrigação no catálogo (ex.: ANM-95-RISR)
  aiStatus        String?      // CONFORME | NAO_CONFORME | NAO_APLICAVEL | SEM_EVIDENCIA
  aiJustification String?
  aiDocumentId    String?
  aiExcerpt       String?
  aiAt            DateTime?
  finalStatus     String?
  finalNote       String?
  lastDoneAt      DateTime?    // última vez que a obrigação foi cumprida (informado pelo revisor)
  reviewedBy      String?
  reviewedAt      DateTime?
  updatedAt       DateTime     @updatedAt

  @@unique([installationId, obligationCode])
  @@index([installationId])
}

// Registro de cada "Analisar documentos novos": quais documentos entraram e o
// que cada um acrescentou, para mostrar o resumo na Análise.
model AnalysisRun {
  id             String       @id @default(cuid())
  installationId String
  installation   Installation @relation(fields: [installationId], references: [id])
  cycleId        String
  mode           String       // INCREMENTAL | COMPLETA
  summaryJson    String       // ver IncrementalSummary em src/lib/incremental-analysis.ts
  createdBy      String
  createdAt      DateTime     @default(now())

  @@index([installationId, cycleId])
}

model Cycle {
  id             String   @id @default(cuid())
  name           String
  installationId String
  installation   Installation @relation(fields: [installationId], references: [id])
  startedAt      DateTime @default(now())
  closedAt       DateTime?

  assessments Assessment[]

  @@index([installationId])
}

// ---------------------------------------------------------------------------
// Documentos e evidências
// ---------------------------------------------------------------------------

model DocumentFile {
  id               String   @id @default(cuid())
  title            String
  type             String
  version          String?
  areaResponsible  String?
  confidentiality  String   @default("INTERNO") // INTERNO | PUBLICO
  validUntil       DateTime?
  fileName         String
  filePath         String
  mimeType         String
  extractedText    String?
  // Quando o documento entrou numa análise da IA. Nulo = documento novo,
  // ainda não analisado (ver src/lib/incremental-analysis.ts).
  analyzedAt       DateTime?
  installationId   String
  installation     Installation @relation(fields: [installationId], references: [id])
  uploadedAt       DateTime @default(now())

  // Governança da informação / disclosure (item 7.7 e 9.7 da proposta)
  targetAudience       String?   // público de destino (ex.: investidores, comunidade, órgão regulador)
  disclosureApproved   Boolean   @default(false)
  disclosureApprovedBy String?
  disclosureApprovedAt DateTime?

  // Versionamento simples: um novo upload pode declarar que substitui um
  // documento anterior, formando uma cadeia de versões navegável.
  previousVersionId String?
  previousVersion   DocumentFile?  @relation("DocumentVersionChain", fields: [previousVersionId], references: [id])
  nextVersions      DocumentFile[] @relation("DocumentVersionChain")

  evidences Evidence[]
  // Ações encerradas usando este documento como evidência (item 19)
  closedActions Action[] @relation("ActionClosureDocument")

  @@index([installationId])
}

model Evidence {
  id            String   @id @default(cuid())
  documentId    String
  document      DocumentFile @relation(fields: [documentId], references: [id])
  requirementId String
  requirement   Requirement  @relation(fields: [requirementId], references: [id])
  excerpt       String
  aiGenerated   Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([documentId])
  @@index([requirementId])
}

// ---------------------------------------------------------------------------
// Avaliação de conformidade (sugestão IA + validação humana)
// ---------------------------------------------------------------------------

enum FinalClassification {
  ATENDE_TOTALMENTE
  ATENDE_PARCIALMENTE
  NAO_ATENDE
  NAO_SE_APLICA
}

enum EvidenceRobustness {
  ROBUSTA
  PARCIAL
  FRACA
  AUSENTE
}

enum GapCriticality {
  ALTA
  MEDIA
  BAIXA
  NAO_SE_APLICA
}

enum ReviewStatus {
  SUGESTAO_IA
  EM_REVISAO
  VALIDADO
}

enum InfoSufficiency {
  SUFICIENTE
  INSUFICIENTE
}

model Assessment {
  id             String   @id @default(cuid())
  requirementId  String
  requirement    Requirement  @relation(fields: [requirementId], references: [id])
  installationId String
  installation   Installation @relation(fields: [installationId], references: [id])
  cycleId        String
  cycle          Cycle        @relation(fields: [cycleId], references: [id])

  // Sugestão da IA (simulada)
  aiClassification  FinalClassification?
  aiRobustness      EvidenceRobustness?
  aiCriticality     GapCriticality?
  aiInfoSufficiency InfoSufficiency?
  aiJustification   String?
  aiConfidence      Float?

  // Decisão final (após revisão humana)
  finalClassification  FinalClassification?
  finalRobustness       EvidenceRobustness?
  finalCriticality      GapCriticality?
  finalInfoSufficiency  InfoSufficiency?
  finalJustification    String?

  status       ReviewStatus @default(SUGESTAO_IA)
  reviewedBy   String?
  reviewedAt   DateTime?

  // Aviso "Rever": um documento novo sugere outra classificação para um
  // requisito já validado. A decisão humana NÃO é alterada; o aviso some
  // ao revalidar ou ao dispensá-lo.
  reviewFlag   String?
  reviewFlagAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actions   Action[]
  auditLogs AuditLog[]
  comments  Comment[]
  revisions AssessmentRevision[]

  @@unique([requirementId, installationId, cycleId])
  @@index([installationId])
  @@index([installationId, cycleId])
}

// Comentários/discussão por requisito (item 12 da proposta) — um mural de
// observações da equipe, separado da justificativa técnica formal.
model Comment {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  author       String
  text         String
  createdAt    DateTime   @default(now())
}

// Histórico estruturado de decisões (item 11 — "trilha de auditoria com
// versionamento de decisões"): cada validação/revalidação grava um snapshot
// dos campos finais, além do log textual do AuditLog, para permitir comparar
// exatamente o que mudou entre uma decisão e outra.
model AssessmentRevision {
  id                   String               @id @default(cuid())
  assessmentId         String
  assessment           Assessment           @relation(fields: [assessmentId], references: [id])
  version              Int
  finalClassification  FinalClassification
  finalRobustness      EvidenceRobustness
  finalCriticality     GapCriticality
  finalInfoSufficiency InfoSufficiency
  finalJustification   String
  reviewedBy           String
  createdAt            DateTime             @default(now())

  @@unique([assessmentId, version])
}

// Biblioteca corporativa de justificativas aprovadas (item 12) — modelos de
// texto reutilizáveis entre requisitos do mesmo tema, para acelerar e
// padronizar a redação de justificativas em ciclos futuros.
model JustificationTemplate {
  id        String   @id @default(cuid())
  themeId   String
  theme     Theme    @relation(fields: [themeId], references: [id])
  title     String
  text      String
  createdBy String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Plano de ação
// ---------------------------------------------------------------------------

enum ActionStatus {
  ABERTA
  EM_ANDAMENTO
  CONCLUIDA
}

enum ActionPriority {
  ALTA
  MEDIA
  BAIXA
}

model Action {
  id              String   @id @default(cuid())
  assessmentId    String
  assessment      Assessment @relation(fields: [assessmentId], references: [id])
  description     String
  responsible     String
  area            String?
  dueDate         DateTime?
  priority        ActionPriority @default(MEDIA)
  status          ActionStatus   @default(ABERTA)
  // Código legível da ação, sequencial por estrutura: PA-001, PA-002... (item 16)
  code            String?
  // Evidência de encerramento (item 19): documento anexado + link, além da
  // observação em texto que já existia.
  closureEvidence   String?
  closureDocumentId String?
  closureDocument   DocumentFile? @relation("ActionClosureDocument", fields: [closureDocumentId], references: [id])
  closureLink       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Dependência entre ações: esta ação só deveria avançar depois que a ação
  // apontada em dependsOnId for concluída.
  dependsOnId String?
  dependsOn   Action?  @relation("ActionDependency", fields: [dependsOnId], references: [id])
  blocks      Action[] @relation("ActionDependency")

  comments ActionComment[]
  logs     ActionLog[]
}

// Mural de comentários por ação (item 9.5 da proposta: "comentários de
// atualização"), separado do mural de comentários da avaliação (Comment).
model ActionComment {
  id        String   @id @default(cuid())
  actionId  String
  action    Action   @relation(fields: [actionId], references: [id])
  author    String
  text      String
  createdAt DateTime @default(now())
}

// Histórico de progresso da ação (item 9.5 da proposta): registra cada
// mudança de status, com quem e quando — trilha própria da ação, distinta
// do AuditLog da avaliação.
model ActionLog {
  id        String   @id @default(cuid())
  actionId  String
  action    Action   @relation(fields: [actionId], references: [id])
  actor     String
  event     String
  note      String?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Análise externa (prior) — avaliação de conformidade trazida de fora da
// plataforma (ex.: Gap Analysis de consultoria) usada como referência pela IA
// e como base da sugestão inicial de cada requisito. É por instalação +
// requisito (não por ciclo): é conhecimento sobre a estrutura, não uma decisão
// de um ciclo específico.
// ---------------------------------------------------------------------------

model ExternalAnalysis {
  id             String       @id @default(cuid())
  installationId String
  installation   Installation @relation(fields: [installationId], references: [id])
  requirementId  String
  requirement    Requirement  @relation(fields: [requirementId], references: [id])
  source         String
  content        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([installationId, requirementId, source])
  @@index([installationId])
}

// ---------------------------------------------------------------------------
// Trilha de auditoria
// ---------------------------------------------------------------------------

model AuditLog {
  id           String   @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  actor        String
  action       String
  note         String?
  createdAt    DateTime @default(now())
}
